    "page": 196,
    "pageTextSha256": "3e931eeba8254cf3ae89d3279c4adf6e8a751d550550dcc4976370b76007aa84",
    "start": "' Выражение взято от древнего обычая",
    "end": "увенчивать победителей лавровыми венками."
  },
  {
    "book": 1,
    "firstPage": 72,
    "heading": "ВОСПОМИНАНИЕ СОБОРА ПРЕСВЯТОЙ БОГОРОДИЦЫ,",
    "sourceSha256": "d8eb94eebea46e0d07798a67d3c15f64d3bb48a85875a8c47c0daa155467fb5c",
    "page": 73,
    "pageTextSha256": "8a8c78ad6b1ed99b911f244280aba4d56691972af472e03007a93922a062b815",
    "start": "' Супруга Византийского императора Феофила",
    "end": "частную жизнь."
  },
  {
    "book": 10,
    "firstPage": 487,
    "heading": "ПРАЗДНОВАНИЕ ВЛАДИМИРСКОЙ ЧУДОТВОРНОЙ ИКОНЕ БОЖИЕЙ МАТЕРИ!",
    "sourceSha256": "5d6ad1d1f29953b1f717fcc709ec01032ad6928b642e5b4664378b70284fb152",
    "page": 489,
    "pageTextSha256": "4be2a452a308d033693fcf391ad3eb734def273d59747ffeadfbb50408d14c5d",
    "start": "1 Митрополит писал великому князю соборное послание",
    "end": "Господь спас ныне Россию»."
  },
  {
    "book": 7,
    "firstPage": 582,
    "heading": "ПАМЯТЬ СВЯТОГО ПРОРОКА ИОАДА",
    "sourceSha256": "569c63acc0bb571cd3380e3e9a283510f0e84b0f739a5785f122ca2b2d77c4e9",
    "page": 583,
    "pageTextSha256": "3adeb2af9401cd2b1a1bec9e9aadebf5645c58c8c2ccc4490ff3b49227320792",
    "start": "устраивались на местах возвышенных.",
    "end": "' О пророке Иоаде повествуется в 13-й главе 3 книги Царств."
  },
  {
    "book": 7,
    "firstPage": 569,
    "heading": "ЖИТИЕ ПРЕПОДОБНОГО ОТЦА НАШЕГО ИОАННА ЛЕСТВИЧНИКА!",
    "sourceSha256": "569c63acc0bb571cd3380e3e9a283510f0e84b0f739a5785f122ca2b2d77c4e9",
    "page": 582,
    "pageTextSha256": "7316d145c42ca93482f4e6c843985e6b1c68a5d1aa79fd7c6ca6e36b24388099",
    "start": "Царство. Победивший «страсти»",
    "end": "учителем и образцом для подчиненных."
  },
  {
    "book": 7,
    "firstPage": 556,
    "heading": "ПАМЯТЬ ПРЕПОДОБНОГО ОТЦА НАШЕГО СТЕФАНА ИСПОВЕДНИКА",
    "sourceSha256": "569c63acc0bb571cd3380e3e9a283510f0e84b0f739a5785f122ca2b2d77c4e9",
    "page": 556,
    "pageTextSha256": "9cad6a5dd0e849fffca16ca22c550a52d0da2387afcecf392dd69f7a1da59c77",
    "start": "' Лев У Армянин",
    "end": "сослан в заточение)."
  },
  {
    "book": 1,
    "firstPage": 86,
    "heading": "ЖИТИЕ СВЯТОГО ИОАННА ПОСТНИКА,",
    "sourceSha256": "d8eb94eebea46e0d07798a67d3c15f64d3bb48a85875a8c47c0daa155467fb5c",
    "page": 89,
    "pageTextSha256": "d41048be5633c2b4cf82b7b73c29f9bb315cfb03148ccdaa18ea17f2e8c44767",
    "start": "1 Это было 2 сентября 595 года",
    "end": "по Рождестве Христовом."
  },
  {
    "book": 1,
    "firstPage": 243,
    "heading": "ЖИТИЕ СВЯТОЙ ЦАРИЦЫ ПУЛЬХЕРИИ",
    "sourceSha256": "d8eb94eebea46e0d07798a67d3c15f64d3bb48a85875a8c47c0daa155467fb5c",
    "page": 253,
    "pageTextSha256": "f15c3b112007318fbfaafe58f62cc9bbe6152d838c46ff29e89ef8d3809cf797",
    "start": "жеством. Последователи их",
    "end": "вскоре после кончины стал праздновать царь Лев (457—474 гг.)."
  },
  {
    "book": 4,
    "firstPage": 661,
    "heading": "СЛОВО НА РОЖДЕСТВО ХРИСТОВО",
    "sourceSha256": "147b1c3fe520c621b8d87d79025adff2be4f1815241296722e51639dc90b36fe",
    "page": 674,
    "pageTextSha256": "a533a31fd7a2d44fc21b1b8993c6a536262005a8b866e9f7c20f773a4956f2a8",
    "start": "' Блаженный Феодорит, епископ Кирский в Сирии, известный особенно сво-",
    "end": "ими толкованиями на Священное Писание. Он жил в У веке."
  },
  {
    "book": 8,
    "firstPage": 70,
    "heading": "ПАМЯТЬ ПРЕПОДОБНОГО ЗОСИМЫ",
    "sourceSha256": "34cad51db160ddb198289ea09aa9cd1745abb00e2f2eba61e6bb229cdc078e90",
    "page": 71,
    "pageTextSha256": "ab9459e0cc52e1e849f16b55df5704fe08986e837ebfe68fc0126796fe3fb6db",
    "start": "' Преподобная скончалась в ночь на Великую пятницу 1 апреля 522 года.",
    "end": "2 Преподобный Зосима скончался в 523 году почти ста лет от роду."
  },
  {
    "book": 1,
    "firstPage": 307,
    "heading": "СКАЗАНИЕ О ВОЗДВИЖЕНИИ ЧЕСТНОГО И ЖИВОТВОРЯЩЕГО КРЕСТА ГОСПОДНЯ",
    "sourceSha256": "d8eb94eebea46e0d07798a67d3c15f64d3bb48a85875a8c47c0daa155467fb5c",
    "page": 316,
    "pageTextSha256": "942a9d9748b91f8424767650311fde28cbc9d710f1a041a23e2b273809163008",
    "start": "` Это было в 629 году по Рождестве Христовом. Патриархом Иерусалимским",
    "end": "персов)."
  },
  {
    "book": 1,
    "firstPage": 316,
    "heading": "ПАМЯТЬ СВЯТОГО МУЧЕНИКА ПАПИЯ",
    "sourceSha256": "d8eb94eebea46e0d07798a67d3c15f64d3bb48a85875a8c47c0daa155467fb5c",
    "page": 317,
    "pageTextSha256": "7f9de1eaa3fa28549d65264ca13d78f813c12b63692adcb76a698694c198877e",
    "start": "каонии (область Малой Азии",
    "end": "кончил в Селевкии Исаврийской."
  },
  {
    "book": 6,
    "firstPage": 30,
    "heading": "ПАМЯТЬ СВЯТОГО И ПРАВЕДНОГО СИМЕОНА БОГОПРИИМЦА",
    "sourceSha256": "01c0ca7096c861b5edf80f97c2ee15484b2bb6c8b59cd0ab751e69690aa72ab9",
    "page": 33,
    "pageTextSha256": "f915e1f883e14249736cbded88532bcffbdb84739a77226e1a729343c03967fe",
    "start": "Епифаний — в учении об отцах Ветхого Завета",
    "end": "показывают, что он был священником."
  },
  {
    "book": 6,
    "firstPage": 33,
    "heading": "ПАМЯТЬ СВЯТОЙ АННЫ ПРОРОЧИЦЫ",
    "sourceSha256": "01c0ca7096c861b5edf80f97c2ee15484b2bb6c8b59cd0ab751e69690aa72ab9",
    "page": 33,
    "pageTextSha256": "f915e1f883e14249736cbded88532bcffbdb84739a77226e1a729343c03967fe",
    "start": "' Подробнее о святой Анне пророчице",
    "end": "см. на стр. 25."
  },
  {
    "book": 2,
    "firstPage": 7,
    "heading": "СЛОВО на ПОКРОВ ПРЕСВЯТОЙ БОГОРОДИЦЫ",
    "sourceSha256": "b33fb5a65d1985f7eef9fe3b0afdf3acc482cd632124240a2672f0652805f849",
    "page": 17,
    "pageTextSha256": "8e8a1ba8f1fdfa69f590aec3ed448e9405c16bbb2b950191150bc8af4b4101ad",
    "start": "1 В день гнева, то есть второго пришествия Христова и последнего страшного",
    "end": "суда."
  },
  {
    "book": 2,
    "firstPage": 17,
    "heading": "СТРАДАНИЕ СВЯТОГО АПОСТОЛА АНАНИИ",
    "sourceSha256": "b33fb5a65d1985f7eef9fe3b0afdf3acc482cd632124240a2672f0652805f849",
    "page": 21,
    "pageTextSha256": "6b4b92caab74fc3f75e464c13e46b41dc6a6fee98bc762d00eea7f3d91816165",
    "start": "' Впоследствии мощи святого апостола Анании",
    "end": "паломник инок Антоний."
  },
  {
    "book": 2,
    "firstPage": 21,
    "heading": "ПАМЯТЬ ПРЕПОДОБНОГО РОМАНА СЛАДКОПЕВЦА",
    "sourceSha256": "b33fb5a65d1985f7eef9fe3b0afdf3acc482cd632124240a2672f0652805f849",
    "page": 25,
    "pageTextSha256": "2a42eee400867fedbed0c75c3ad71a66cf89e9d3996fe41845565c596e635ae2",
    "start": "праздников, а также в честь святых и в память усопших",
    "end": "ловине У века. Кончина его последовала в конце века."
  },
  {
    "book": 2,
    "firstPage": 25,
    "heading": "ЖИТИЕ ПРЕПОДОБНОГО САВВЫ ВИШЕРСКОГО",
    "sourceSha256": "b33fb5a65d1985f7eef9fe3b0afdf3acc482cd632124240a2672f0652805f849",
    "page": 35,
    "pageTextSha256": "24bb990e831b59973e8910ade662253b3107b7f34ca9e8ee5f1fc3525a681e1e",
    "start": "' Это было в 1523 году.",
    "end": "Во имя его в обители — два храма."
  },
  {
    "book": 2,
    "firstPage": 37,
    "heading": "ЖИТИЕ И СТРАДАНИЕ СВЯТОГО СВЯЩЕННОМУЧЕНИКА КИПРИАНА И СВЯТОЙ МУЧЕНИЦЫ ИУСТИНЫ",
    "sourceSha256": "b33fb5a65d1985f7eef9fe3b0afdf3acc482cd632124240a2672f0652805f849",
    "page": 52,
    "pageTextSha256": "6716a101b5915b0fc9f03a4c97d82c088dde3b0837bd79f9fc9f2670958f2648",
    "start": "' Римский император Клавдий П царствовал",
    "end": "тых Киприана, Иустины и Феоктиста последовала около 268 года."
  },
  {
    "book": 2,
    "firstPage": 74,
    "heading": "ЖИТИЕ И СТРАДАНИЕ СВЯТОГО СВЯЩЕННОМУЧЕНИКА ДИОНИСИЯ АРЕОПАГИТА",
    "sourceSha256": "b33fb5a65d1985f7eef9fe3b0afdf3acc482cd632124240a2672f0652805f849",
    "page": 81,
    "pageTextSha256": "e7e2cf92040a2815c085ee99f38eb59c6cac5e1481c1486cf8275870a952b2b9",
    "start": "' Дионисию Ареопагиту, кроме вышеозначенного",
    "end": "ным лицам»."
  },
  {
    "book": 2,
    "firstPage": 88,
    "heading": "ЖИТИЕ СВЯТЫХ ГУРИЯ,",
    "sourceSha256": "b33fb5a65d1985f7eef9fe3b0afdf3acc482cd632124240a2672f0652805f849",
    "page": 95,
    "pageTextSha256": "3eb105cb9ae51c1f906971458ea046e474a2a205ab111751ef59bc93061de655",
    "start": "' Долго почивали святые мощи Гурия и Варсонофия",
    "end": "Димитрием Ростовским."
  },
  {
    "book": 2,
    "firstPage": 96,
    "heading": "ЖИТИЕ ПРЕПОДОБНОГО ОТЦА НАШЕГО АММОНА",
    "sourceSha256": "b33fb5a65d1985f7eef9fe3b0afdf3acc482cd632124240a2672f0652805f849",
    "page": 100,
    "pageTextSha256": "7fc94201a36d8276228f2e3306a1d364cbafe8faac9302cd5dfdfdd36da7a524",
    "start": "! То есть из Нитрийской пустыни",
    "end": "опытной духовной мудрости."
  },
  {
    "book": 2,
    "firstPage": 100,
    "heading": "ЖИТИЕ ПРЕПОДОБНОГО ОТЦА НАШЕГО ПАВЛА ПРЕПРОСТОГО",
    "sourceSha256": "b33fb5a65d1985f7eef9fe3b0afdf3acc482cd632124240a2672f0652805f849",
    "page": 106,
    "pageTextSha256": "edeec04f72b9221900c84942477cd1dbf107660eb69216c4082cc9cc44d5a537",
    "start": "1 Преподобный Павел скончался",
    "end": "в [У веке."
  },
  {
    "book": 2,
    "firstPage": 106,
    "heading": "ПАМЯТЬ СВЯТЫХ МУЧЕНИКОВ ГАИЯ, ФАВСТА, ЕВСЕВИЯ и ХЕРИМОНА",
    "sourceSha256": "b33fb5a65d1985f7eef9fe3b0afdf3acc482cd632124240a2672f0652805f849",
    "page": 107,
    "pageTextSha256": "17049b7926d15fa96ae416cc0d14c8f16f126cf20ce3298fbd32350a275b777b",
    "start": "' Фавст, Евсевий и Херимон, по свидетельству самого их учителя",
    "end": "половине Ш века."
  },
  {
    "book": 2,
    "firstPage": 108,
    "heading": "ПАМЯТЬ ПРЕПОДОБНОМУЧЕНИКА ПЕТРА,",
    "sourceSha256": "b33fb5a65d1985f7eef9fe3b0afdf3acc482cd632124240a2672f0652805f849",
    "page": 109,
    "pageTextSha256": "c09aca7c8a7e29144ad9210f4ab9afe31ab524e1fb83e5bc246b37a947f4ebb8",
    "start": "Бостра — город в Аравии.",
    "end": "Время кончины святого Петра полагают в Ш или начале ГУ века."
  },
  {
    "book": 2,
    "firstPage": 115,
    "heading": "ЖИТИЕ ПРЕПОДОБНОГО ДАМИАНА ПЕЧЕРСКОГО",
    "sourceSha256": "b33fb5a65d1985f7eef9fe3b0afdf3acc482cd632124240a2672f0652805f849",
    "page": 117,
    "pageTextSha256": "a7a8a13e36f8d04143a3d57eb2fd4c0bf04e59b41707acf27cd7f49c0b2068e1",
    "start": "' Преподобный Дамиан преставился",
    "end": "ниевой пещере Киево-Печерской лавры."
  },
  {
    "book": 2,
    "firstPage": 117,
    "heading": "ЖИТИЕ ПРЕПОДОБНОГО ИЕРЕМИИ ПЕЧЕРСКОГО",
    "sourceSha256": "b33fb5a65d1985f7eef9fe3b0afdf3acc482cd632124240a2672f0652805f849",
    "page": 118,
    "pageTextSha256": "f07b46ca5c0bed428b18e2cd95c534990c5fe8442b734ed19910de7748e5bf15",
    "start": "ТВ 1074 году.",
    "end": "ТВ 1074 году."
  },
  {
    "book": 2,
    "firstPage": 118,
    "heading": "ЖИТИЕ ПРЕПОДОБНОГО МАТФЕЯ ПЕЧЕРСКОГО",
    "sourceSha256": "b33fb5a65d1985f7eef9fe3b0afdf3acc482cd632124240a2672f0652805f849",
    "page": 120,
    "pageTextSha256": "ca4bd20ae9a37c7d37fba213c55c8e0b3db883b36c1025154c665ef0aafc3e6e",
    "start": "ТВ 1088 году.",
    "end": "2 В Антониевой пещере."
  },
  {
    "book": 2,
    "firstPage": 164,
    "heading": "ПАМЯТЬ СВЯТЫХ МУЧЕНИКОВ ИУЛИАНА и КЕСАРИЯ",
    "sourceSha256": "b33fb5a65d1985f7eef9fe3b0afdf3acc482cd632124240a2672f0652805f849",
    "page": 165,
    "pageTextSha256": "f44b2bdc725d88030e57077d611f227b003432d4ee5f543f2ab9b56ea8363470",
    "start": "' Капуя — город и крепость в Южной Италии",
    "end": "ня, а честная рука его — в церкви Святая Святых."
  },
  {
    "book": 2,
    "firstPage": 165,
    "heading": "ПАМЯТЬ СВЯТОГО МУЧЕНИКА ПОЛИХРОНИЯ",
    "sourceSha256": "b33fb5a65d1985f7eef9fe3b0afdf3acc482cd632124240a2672f0652805f849",
    "page": 166,
